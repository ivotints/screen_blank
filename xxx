#!/usr/bin/env bash
#
# blank-session.sh — inhibit idle/sleep, blank screen, press Super, start mouce.py; restore on Ctrl-C
#

# If not already under systemd-inhibit, re-exec ourselves under it
if [ -z "$UNDER_INHIBIT" ]; then
  export UNDER_INHIBIT=1
  exec systemd-inhibit \
    --what=idle:sleep:handle-lid-switch:handle-power-key:handle-suspend-key:handle-hibernate-key \
    --mode=block \
    --why="Blank screen without lock for interactive session" \
    "$0" "$@"
fi

# detect the first connected output (change if you need a specific one)
OUTPUT=$(xrandr | awk '/ connected/ { print $1; exit }')

# Turn off any automatic blanking/DPMS on X11
xset s off
xset s noblank
xset -dpms

# Disable GNOME's own idle/lock logic
gsettings set org.gnome.desktop.session idle-delay 0
gsettings set org.gnome.desktop.screensaver lock-enabled false
gsettings set org.gnome.desktop.screensaver idle-activation-enabled false

# Additional GNOME settings to prevent auto-logout
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout 0
gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-timeout 0
gsettings set org.gnome.desktop.screensaver ubuntu-lock-on-suspend false

# Store original values for restoration
ORIG_IDLE_DELAY=$(gsettings get org.gnome.desktop.session idle-delay)
ORIG_LOCK_ENABLED=$(gsettings get org.gnome.desktop.screensaver lock-enabled)
ORIG_IDLE_ACTIVATION=$(gsettings get org.gnome.desktop.screensaver idle-activation-enabled)
ORIG_SLEEP_AC=$(gsettings get org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout)
ORIG_SLEEP_BATTERY=$(gsettings get org.gnome.settings-daemon.plugins.power sleep-inactive-battery-timeout)

# function to restore brightness and kill mouse script
cleanup() {
  # stop mouse jiggle
  kill "$MOUSE_PID" 2>/dev/null || true

  # restore GNOME backlight to 100%
  gdbus call --session \
    --dest org.gnome.SettingsDaemon.Power \
    --object-path /org/gnome/SettingsDaemon/Power \
    --method org.freedesktop.DBus.Properties.Set \
      org.gnome.SettingsDaemon.Power.Screen \
      Brightness "<int32 100>"

  # restore xrandr brightness
  xrandr --output "$OUTPUT" --brightness 1

  # restore original GNOME settings
  gsettings set org.gnome.desktop.session idle-delay "$ORIG_IDLE_DELAY"
  gsettings set org.gnome.desktop.screensaver lock-enabled "$ORIG_LOCK_ENABLED"
  gsettings set org.gnome.desktop.screensaver idle-activation-enabled "$ORIG_IDLE_ACTIVATION"
  gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout "$ORIG_SLEEP_AC"
  gsettings set org.gnome.settings-daemon.plugins.power sleep-inactive-battery-timeout "$ORIG_SLEEP_BATTERY"

  exit
}

# trap Ctrl-C to restore on exit
trap cleanup SIGINT

# BLANK the screen:
# 1) set GNOME backlight to 0%
gdbus call --session \
  --dest org.gnome.SettingsDaemon.Power \
  --object-path /org/gnome/SettingsDaemon/Power \
  --method org.freedesktop.DBus.Properties.Set \
    org.gnome.SettingsDaemon.Power.Screen \
    Brightness "<int32 0>"

# 2) set xrandr brightness to 0
xrandr --output "$OUTPUT" --brightness 0

# Store working dir
PWD=$(pwd)

# Start your key-press helper first (so you can wake with Super)
python3 "$PWD/win_button.py"

# Start your mouse-jiggle script in background
python3 "$PWD/mouce.py" &
MOUSE_PID=$!

# Periodically send a key event to prevent any remaining timeouts
while kill -0 "$MOUSE_PID" 2>/dev/null; do
  sleep 300  # every 5 minutes
  python3 "$PWD/win_button.py" >/dev/null 2>&1 || true
done

# Wait here until Ctrl-C
wait "$MOUSE_PID"